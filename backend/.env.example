# Copiez ce fichier en ".env" (jamais commité) si vous voulez changer la config.
# Sans .env, l'API démarre quand même en SQLite (pas besoin de Docker).

# --- Option simple (défaut) : SQLite, aucun Docker ---
DATABASE_URL=sqlite:///./getclose.db

# --- Option grille FastAPI : PostgreSQL via Docker ---
# docker compose up -d db
# DATABASE_URL=postgresql+psycopg://getclose:getclose@localhost:5432/getclose

JWT_SECRET_KEY=change-me-before-deploying
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
